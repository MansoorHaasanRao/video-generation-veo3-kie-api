      ],
      "id": "7b2ab737-4cef-4763-ace0-9cb9dc469ac6",
      "name": "prompt genrator"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=you are a proffesional story creater. i will give you the title you will create a 2 parts of the story that connect each other \nStory Title:\nThe format will be:{{ $json.title }}\n\nPart 1\n\nStrong opening that introduces the characters and setting.\nBuilds suspense and emotion.\nEnds with a dramatic cliffhanger.\nDesigned around part 1 (a cinematic scene that captures the key moment).\n\nPart 2\n\nBegins immediately after the cliffhanger.\nReveals the truth or resolves the conflict.\nEnds with a memorable conclusion.\nDesigned around part (the story's climax or final emotional moment).",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
