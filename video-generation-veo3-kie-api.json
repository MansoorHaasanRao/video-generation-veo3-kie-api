    {
      "parameters": {
        "promptType": "define",
        "text": "=you are prompt genrator.I will give you the 2 parts of the story. you will genrate a two prompt of the story. These prompt use for video genration and each part prompt cover 8 second.\nYou are a cinematic video prompt generator.\n\nI will give you 2 parts of a story.\nGenerate 2 detailed video prompts (one for each part).\n\nEach prompt must:\n- Represent ~8 seconds of video\n- Include cinematic details (camera movement, lighting, mood, environment)\n- Maintain character and scene consistency\nStory:\npart 1:{{ $json.output.part1 }}\npart 2:{{ $json.output.part2 }}",
        "hasOutputParser": true,
        "options": {}
      },
